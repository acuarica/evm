{
    "name": "sevm",
    "version": "0.7.4",
    "description": "A Symbolic Ethereum Virtual Machine (EVM) bytecode decompiler & analyzer library & CLI",
    "type": "module",
    "main": "./dist/src/index.js",
    "types": "./dist/src/index.d.ts",
    "exports": {
        ".": {
            "import": "./src/index.ts"
        },
        "./ast": {
            "import": "./src/ast/index.ts"
        },
        "./4byte": {
            "types": "./4byte/index.d.ts",
            "default": "./4byte/index.js"
        },
        "./4bytedb": {
            "types": "./4bytedb/index.d.ts",
            "default": "./4bytedb/index.js"
        }
    },
    "bin": {
        "sevm": "./bin/sevm.mjs"
    },
    "files": [
        "src/",
        "dist/src/",
        "dist/sevm.js",
        "4byte/",
        "4bytedb/",
        "bin/"
    ],
    "repository": "acuarica/evm",
    "author": "Luis Mastrangelo (https://acuarica.github.io)",
    "contributors": [
        "Luit Hollander <luit@hollander.email> (https://luit.me)"
    ],
    "license": "MIT",
    "keywords": [
        "4byte",
        "blockchain",
        "bytecode",
        "cli",
        "control-flow-graph",
        "decoder",
        "decompiler",
        "disassembler",
        "ethereum",
        "evm",
        "parser",
        "signatures",
        "solidity",
        "typescript",
        "web3",
        "yul"
    ],
    "dependencies": {
        "ansi-colors": "^4.1.3",
        "env-paths": "^3.0.0",
        "js-sha3": "^0.9.3",
        "yargs": "^17.7.2"
    },
    "devDependencies": {
        "@jsdevtools/chai-exec": "^2.1.1",
        "@size-limit/file": "^11.0.2",
        "@types/node": "^22.19.17",
        "@types/yargs": "^17.0.32",
        "@vitest/coverage-v8": "^4.1.4",
        "eslint": "^10.2.0",
        "ethers": "^6.13.1",
        "size-limit": "^11.0.2",
        "solc": "^0.8.21",
        "typescript": "^6.0.2",
        "typescript-eslint": "^8.58.1",
        "vitest": "^4.1.4"
    },
    "scripts": {
        "prepare": "node scripts/4bytedb.mjs",
        "typecheck": "tsc",
        "lint": "eslint .",
        "test": "vitest --run",
        "coverage": "vitest run --coverage",
        "bundle": "webpack --mode production",
        "size": "size-limit",
        "make:4bytedb": "node scripts/4bytedb.mjs",
        "make:ercs": "scripts/ercs.mjs > src/ercs.ts",
        "make:help": "scripts/help.mjs README.md",
        "make:docs": "cp README.md docs && typedoc --out docs/tsdoc src/index.ts src/ast/index.ts",
        "docs": "npx http-server docs",
        "clean": "rm -r .artifacts/"
    },
    "engines": {
        "node": ">=22.18.0",
        "npm": ">=11.10.0"
    }
}
